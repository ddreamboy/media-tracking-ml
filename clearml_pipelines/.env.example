# ClearML
CLEARML_API_HOST=https://api.clear.ml
CLEARML_API_ACCESS_KEY=
CLEARML_API_SECRET_KEY=
CLEARML_PROJECT_NAME=media_tracking_topic_modeling

# HuggingFace
HF_TOKEN=
HF_USERNAME=ddreamboy
HF_MODEL_REPO=media-tracking-topics
HF_DATASET_REPO=media-tracking-data

# LLM (routerai.ru, OpenAI-compatible)
LLM_BASE_URL=https://routerai.ru/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemini-2.5-flash-lite

# Embedder
# Обучение - локально на GPU. На инференсе та же модель берётся через Router AI
# (qwen/qwen3-embedding-4b), поэтому менять здесь модель без правки воркера нельзя.
EMBEDDING_PROVIDER=local_hf
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-4B
EMBEDDING_BATCH_SIZE=2
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_TORCH_DTYPE=float16
# 0 = нативная размерность модели (2560 у Qwen3-Embedding-4B).
# При усечении менять синхронно с воркером инференса.
EMBEDDING_DIMENSIONS=0
# If EMBEDDING_PROVIDER != local_hf:
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_MAX_WORKERS=8

# Database
DB_CONNECTION_STRING=postgresql://user:password@localhost:5432/media_tracking

# Pipeline
PIPELINE_TIMEOUT_SECONDS=14400
DRIFT_WINDOW_DAYS=3
N_FULL_CORPUS=300000
